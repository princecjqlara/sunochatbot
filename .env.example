NODE_ENV=development
NEXTAUTH_URL=http://localhost:3100
# Public HTTPS origin used by Messenger media-card buttons (defaults to NEXTAUTH_URL).
PUBLIC_APP_URL=
NEXTAUTH_SECRET=replace-with-a-long-random-secret

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_APP_SECRET=
# Local diagnostics for the separately configured partner Meta app.
FACEBOOK_PARTNER_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_URL=http://localhost:3100/api/facebook/webhook
# Optional: route selected Pages from a second Meta app, preserving its old callback for other Pages.
FACEBOOK_PARTNER_APP_SECRET=
FACEBOOK_PARTNER_CHATBOT_PAGE_IDS=
FACEBOOK_PARTNER_LEGACY_WEBHOOK_URL=

NEXT_PUBLIC_SUPABASE_URL=https://cxgynadprukyeuqbchbs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL_5432=
DATABASE_POOLER_URL_6543=
# Temporarily stop scheduled work and interactive database queries during recovery.
# Facebook webhook events continue to be saved to the durable inbox.
VEO_DATABASE_RECOVERY_MODE=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_MULTIMODAL_MODEL=google/gemini-3.8-flash
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# Optional: only needed for private Drive folders. Public “Anyone with the link” folders need no credentials.
# Keep literal \\n characters when storing this on one line, for example: -----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
GOOGLE_DRIVE_PRIVATE_KEY=
# Alternative to the two values above: the complete service-account JSON on one line.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
CHATBOT_RAG_MATCH_THRESHOLD=0.35

# Telegram group -> chatbot media bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-token
# A separate media-bridge bot may be configured later; @dannysunobot belongs to Jaucian.
TELEGRAM_MEDIA_ROUTES={}

CRON_SECRET=

# Optional separate signing key for customer form links; defaults to NEXTAUTH_SECRET.
CHATBOT_FORM_SECRET=
# VEO workspace (enable only after compatible migrations, both deployments, and launch)
VEO_WORKSPACE_ENABLED=false
VEO_JAUCIAN_URL=
VEO_JAUCIAN_SECRET=
VEO_APPROVED_TELEGRAM_CHAT_IDS=

# Compatibility flags use Suno's own identity and data.
# Publishing setup mode pauses API writes and scheduled work until cutover.
SUNO_DEPLOYMENT_STAGE=setup
VEO_OWNER_USER_ID=1e56fd95-56af-4aca-b50f-89a48c083249
VEO_DATABASE_PROJECT_REF=cxgynadprukyeuqbchbs
VEO_PAGE_SCOPE_ENFORCED=true
VEO_ENFORCE_PAGE_RUNTIME_SCOPE=true
SUNO_FINANCIAL_POLICY_CONFIRMED=false
SUNO_SYSTEM_ENABLED=true
# Optional sign-in alias for this deployment's retained Owner only. Keep the
# legacy account email intact while the old Facebook-based app remains live.
SUNO_OWNER_LOGIN_EMAIL=
SUNO_OWNER_ACCOUNT_EMAIL=
SUNO_FORECAST_MODEL_VALIDATED=false
# Refresh full contact profiles from authorized Meta history, using the saved model setting.
SUNO_CONTACT_PROFILE_MODE=remote
# Full exports include all messages Meta returns, with per-Page permissions.
SUNO_HISTORY_SOURCE=meta
SUNO_WORKSPACE_URL=
VEO_CHATBOT_ENABLED=true
SUNO_SCHEDULER_OWNER=vercel
# Keep TELEGRAM_BOT_TOKEN empty here. @dannysunobot belongs to jaucian only.
